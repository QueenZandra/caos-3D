{
  "name": "caos-em-casa",
  "version": "0.1.0",
  "description": "Caos em Casa: A Saga dos Pets — co-op caótico 3D (Babylon.js)",
  "type": "module",
  "scripts": {
    "copy-havok": "node scripts/copy-havok.mjs",
    "predev": "node scripts/copy-havok.mjs",
    "prebuild": "node scripts/copy-havok.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@babylonjs/core": "^7.34.0",
    "@babylonjs/gui": "^7.34.0",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/loaders": "^7.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.8.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
